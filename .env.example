# docker compose reads .env (git-ignored). Create it with:  .\infrastructure\docker\create-docker-env.ps1
GPS_DATABASE_PASSWORD=
SMART_TRUCK_DATABASE_USERNAME=
SMART_TRUCK_DATABASE_PASSWORD=

# Optional overrides
# GPS_PROCESSING_FLOW=kafka
# GPS_SIMULATOR_AUTOSTART=true
# GPS_SIMULATOR_VEHICLE_COUNT=150

# Routing (GraphHopper + gps-route-service), see docs/ROUTING_ENGINE_SETUP.md
# COMPOSE_PROFILES=routing                          # start them with every "docker compose up -d"
# GPS_ROUTING_MAP_REGION=asia/india                 # or one zone, e.g. asia/india/eastern-zone
# GPS_ROUTING_IMPORT_JAVA_OPTS=-Xmx7g               # heap for the one-time map import
# GPS_ROUTING_SERVER_JAVA_OPTS=-Xmx3g               # heap while serving
