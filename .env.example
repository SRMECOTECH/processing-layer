# docker compose reads .env (git-ignored). Create it with:  .\infrastructure\docker\create-docker-env.ps1
GPS_DATABASE_PASSWORD=
SMART_TRUCK_DATABASE_USERNAME=
SMART_TRUCK_DATABASE_PASSWORD=

# Dashboard sign-in (http://localhost:3000). Until these are set the account is abc / abc: change it before
# the dashboard is reachable by anyone else. DASHBOARD_AUTH_SECRET: any long random text; it signs the session cookie.
# DASHBOARD_USERNAME=
# DASHBOARD_PASSWORD=
# DASHBOARD_AUTH_SECRET=

# Optional overrides
# GPS_PROCESSING_FLOW=kafka
# GPS_SIMULATOR_AUTOSTART=true
# GPS_SIMULATOR_VEHICLE_COUNT=150

# HP home server (hotspot "SANJOY-HP 0161", always 192.168.137.1). Defaults shown; Developer -> Connections in the
# dashboard changes Valhalla and Redis while the service runs, and that choice wins over these.
# VALHALLA_URL=http://192.168.137.1:8002
# HOME_SERVER_REDIS_URL=redis://192.168.137.1:6379/1
# GPS_INGESTION_API_URL=http://192.168.137.1:8000
